# Groq Cloud API Key (Optional: AXEL falls back gracefully to offline TF-IDF & AST token classification)
GROQ_API_KEY=

# LLM Model Configuration
AXEL_MODEL_NAME=qwen/qwen3.8-27b
AXEL_GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile

# Pipeline & Storage Settings
AXEL_INPUT_FOLDER=./documents
AXEL_INDEX_FILE=axel_index.json
AXEL_MAX_KEYWORDS=10
AXEL_TOP_K_RESULTS=5

# Server & Network Security Settings
# By default, AXEL binds strictly to loopback (127.0.0.1) for local safety
AXEL_HOST=127.0.0.1
AXEL_PORT=8765

# API Security Token (Optional: if omitted, an ephemeral high-entropy session token is generated on launch)
# AXEL_API_KEY=

# Allowed CORS Origins (Optional comma-separated list; loopback is permitted by default)
# AXEL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
